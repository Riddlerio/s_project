SECRET_KEY=replace-for-production
DATABASE_URL=sqlite:///./speech_hero.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false
COOKIE_SECURE=true
TRANSCRIPT_RETENTION_DAYS=90
# 프로덕션에서 빌드된 화면(dist) 경로. 비우면 API만 서비스한다.
FRONTEND_DIST=
# 호야와 대화하기. false이면 외부 LLM 없이 DEMO 대화만 쓴다. API key는 서버에만 둔다.
HOYA_CHAT_ENABLED=false
HOYA_CHAT_PROVIDER=openai
# 권장: gpt-5.4-mini(기본 추론 단계 none이라 8초 제한 안에 답한다). 추론 기본값이 medium인 모델은 시간 초과가 날 수 있다.
HOYA_CHAT_MODEL=
OPENAI_API_KEY=
# 치료사 회기 계획 요약. 꺼져 있으면 서버 계산 템플릿 요약을 씁니다. 권장: gpt-5.4-mini
THERAPIST_SUMMARY_ENABLED=false
THERAPIST_SUMMARY_MODEL=
